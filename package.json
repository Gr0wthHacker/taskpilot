{
  "name": "taskpilot",
  "version": "0.1.0",
  "description": "Local-first desktop task & calendar manager that treats Claude as a first-class operator.",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "bin": {
    "taskpilot": "./dist/cli/index.js"
  },
  "author": "Jack Gierlich",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently \"vite\" \"npm run dev:main\"",
    "dev:main": "tsup --watch --onSuccess \"electron .\"",
    "build": "vite build && vite build -c vite.config.capture.ts && tsup && tsup src/cli/index.ts --out-dir dist/cli && tsx scripts/copy-runtime-assets.ts",
    "postinstall": "tsx scripts/rebuild-native.ts",
    "build:electron": "npm run build && electron-builder",
    "cli": "tsx src/cli/index.ts",
    "server": "tsx src/main/server/standalone.ts",
    "mcp": "tsx src/main/mcp/standalone.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/main/db/migrate.ts",
    "db:status": "tsx src/main/db/cli.ts status",
    "db:rollback": "tsx src/main/db/cli.ts rollback",
    "smoke": "tsx scripts/smoke-test.ts",
    "rebuild:native": "tsx scripts/rebuild-native.ts",
    "build:extension": "npm --prefix packages/chrome-extension install && npm --prefix packages/chrome-extension run build",
    "icon": "tsx scripts/generate-icon.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@notionhq/client": "^5.22.0",
    "@octokit/rest": "^21.1.1",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@slack/web-api": "^7.16.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-virtual": "^3.14.2",
    "better-sqlite3": "^12.10.0",
    "chalk": "^5.3.0",
    "chokidar": "^4.0.0",
    "chrome-remote-interface": "^0.33.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.36.0",
    "electron-log": "^5.4.4",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "googleapis": "^144.0.0",
    "lucide-react": "^0.453.0",
    "mammoth": "^1.8.0",
    "nanoid": "^5.0.7",
    "node-html-parser": "^7.0.1",
    "ora": "^8.1.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.27.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.12.0",
    "@typescript-eslint/parser": "^8.12.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/ui": "^2.1.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.28.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
