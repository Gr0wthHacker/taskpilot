{
  "name": "@taskpilot/chrome-extension",
  "version": "0.1.0",
  "private": true,
  "description": "TaskPilot browser context capture — sends visited URLs/titles to the local TaskPilot API.",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.24.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.0"
  }
}
